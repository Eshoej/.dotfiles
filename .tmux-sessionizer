#!/bin/bash

# 1. Rename your current window to 'claude' so you know where you are
tmux rename-window "claude"

# 2. Open a new window (tab) named 'editor' and run vim
# The -d flag creates it in the background so you don't "jump" yet
tmux new-window -n "editor" -d
tmux send-keys -t "editor" "vim" C-m

# 3. Open another new window for 'misc' stuff
tmux new-window -n "misc" -d

# 4. (Optional) Explicitly ensure focus is on 'claude' 
# Though since we used -d, you never actually left.
tmux select-window -t "claude"
claude
